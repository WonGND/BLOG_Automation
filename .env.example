# Anthropic API 키 (필수)
# https://console.anthropic.com 에서 발급받아 붙여넣으세요.
ANTHROPIC_API_KEY=sk-ant-...

# 서버 포트 (선택, 기본 3000)
PORT=3000

# 사용할 모델 (선택, 기본 claude-opus-5)
MODEL=claude-opus-5

# 추론 강도 (선택): low | medium | high | xhigh | max
EFFORT_SUGGEST=medium
EFFORT_WRITE=high

# 규칙 위반 시 자동 재작성 횟수 (선택, 기본 1, 최대 3)
MAX_REPAIR=1

# 생성 결과를 output/ 폴더에 자동 저장 (선택, 기본 true)
SAVE_OUTPUT=true
